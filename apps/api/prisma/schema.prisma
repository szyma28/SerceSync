generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  CARER
  SENIOR_CARER
  MANAGER
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  COMPLETED
  DEFERRED
  ESCALATED
  OVERDUE
}

enum ResidentTimelineEntryType {
  CARE_GIVEN
  OBSERVATION
  PERSONAL_CARE
  NUTRITION_HYDRATION
  MOBILITY_REPOSITIONING
  MEDICATION_NOTE
  ESCALATION
}

enum ResidentPriorityLevel {
  GREEN
  AMBER
  RED
}

enum IncidentSeverity {
  AMBER
  RED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentCategory {
  FALL
  MEDICATION
  BEHAVIOUR
  INJURY
  OTHER
}

enum PersonalCareSubtype {
  SHOWER
  CONTINENCE
  FOOT_CARE
  SKIN_CARE
}

enum AuditEventKind {
  HANDOVER_ACKNOWLEDGED
  TASK_COMPLETED
  TASK_DEFERRED
  TASK_ESCALATED
  RESIDENT_TIMELINE_ENTRY_CREATED
  RESIDENT_TIMELINE_MEDIA_ATTACHED
  INCIDENT_CREATED
  INCIDENT_MEDIA_ATTACHED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_RESOLVED
  SHIFT_STARTED
  SHIFT_ENDED
  USER_LOGIN
  USER_LOGOUT
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       RoleKey  @unique
  label     String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique
  displayName              String
  passwordHash             String?
  isActive                 Boolean                   @default(true)
  roleId                   String                    @db.Uuid
  role                     Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedTasks            Task[]                    @relation("AssignedTasks")
  assignedShifts           Shift[]                   @relation("AssignedShifts")
  auditEvents              AuditEvent[]
  createdHandovers         Handover[]                @relation("CreatedHandovers")
  handoverAcknowledgements HandoverAcknowledgement[]
  residentTimelineEntries  ResidentTimelineEntry[]
  uploadedTimelineMedia    ResidentTimelineMedia[]
  createdIncidents         Incident[]                @relation("CreatedIncidents")
  acknowledgedIncidents    Incident[]                @relation("AcknowledgedIncidents")
  resolvedIncidents        Incident[]                @relation("ResolvedIncidents")
  uploadedIncidentMedia    IncidentMedia[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([roleId])
  @@map("users")
}

model Shift {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String
  startsAt        DateTime
  endsAt          DateTime
  status          ShiftStatus             @default(PLANNED)
  floorNumber     Int                     @default(1)
  unitLabel       String                  @default("Willow Floor")
  handover        Handover?
  tasks           Task[]
  assignedUsers   User[]                  @relation("AssignedShifts")
  timelineEntries ResidentTimelineEntry[]
  incidents       Incident[]
  auditEvents     AuditEvent[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status, startsAt])
  @@map("shifts")
}

model Handover {
  id               String                    @id @default(uuid()) @db.Uuid
  shiftId          String                    @unique @db.Uuid
  shift            Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  summary          String
  createdById      String?                   @db.Uuid
  createdBy        User?                     @relation("CreatedHandovers", fields: [createdById], references: [id], onDelete: SetNull)
  acknowledgements HandoverAcknowledgement[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([createdById])
  @@map("handovers")
}

model HandoverAcknowledgement {
  id               String   @id @default(uuid()) @db.Uuid
  handoverId       String   @db.Uuid
  handover         Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  acknowledgedById String   @db.Uuid
  acknowledgedBy   User     @relation(fields: [acknowledgedById], references: [id], onDelete: Cascade)
  acknowledgedAt   DateTime @default(now())

  @@unique([handoverId, acknowledgedById])
  @@index([acknowledgedById])
  @@map("handover_acknowledgements")
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  shiftId         String       @db.Uuid
  shift           Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  residentId      String?      @db.Uuid
  resident        Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus   @default(PENDING)
  dueAt           DateTime?
  statusNote      String?
  statusUpdatedAt DateTime?
  assignedUserId  String?      @db.Uuid
  assignedUser    User?        @relation("AssignedTasks", fields: [assignedUserId], references: [id], onDelete: SetNull)
  auditEvents     AuditEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([shiftId, status])
  @@index([assignedUserId])
  @@index([residentId])
  @@index([dueAt])
  @@map("tasks")
}

model Resident {
  id                  String                  @id @default(uuid()) @db.Uuid
  fullName            String
  roomNumber          Int
  roomLabel           String
  floorNumber         Int
  unitLabel           String
  recognitionImageKey String
  careSummary         String
  isActive            Boolean                 @default(true)
  baselinePriority    ResidentPriorityLevel   @default(GREEN)
  tasks               Task[]
  timelineEntries     ResidentTimelineEntry[]
  incidents           Incident[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([floorNumber, roomNumber])
  @@index([floorNumber, isActive])
  @@map("residents")
}

model ResidentTimelineEntry {
  id                  String                    @id @default(uuid()) @db.Uuid
  residentId          String                    @db.Uuid
  resident            Resident                  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type                ResidentTimelineEntryType
  personalCareSubtype PersonalCareSubtype?
  title               String
  details             String
  createdById         String?                   @db.Uuid
  createdBy           User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  shiftId             String?                   @db.Uuid
  shift               Shift?                    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  media               ResidentTimelineMedia[]
  createdAt           DateTime                  @default(now())

  @@index([residentId, createdAt])
  @@index([createdById])
  @@index([shiftId])
  @@map("resident_timeline_entries")
}

model ResidentTimelineMedia {
  id               String                @id @default(uuid()) @db.Uuid
  entryId          String                @db.Uuid
  entry            ResidentTimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  originalFileName String
  mediaType        String
  byteSize         Int
  storageKey       String
  uploadedById     String?               @db.Uuid
  uploadedBy       User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())

  @@index([entryId, createdAt])
  @@index([uploadedById])
  @@map("resident_timeline_media")
}

model Incident {
  id               String           @id @default(uuid()) @db.Uuid
  residentId       String           @db.Uuid
  resident         Resident         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  shiftId          String           @db.Uuid
  shift            Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdById      String?          @db.Uuid
  createdBy        User?            @relation("CreatedIncidents", fields: [createdById], references: [id], onDelete: SetNull)
  severity         IncidentSeverity
  status           IncidentStatus   @default(OPEN)
  category         IncidentCategory
  title            String
  details          String
  occurredAt       DateTime         @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?          @db.Uuid
  acknowledgedBy   User?            @relation("AcknowledgedIncidents", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?          @db.Uuid
  resolvedBy       User?            @relation("ResolvedIncidents", fields: [resolvedById], references: [id], onDelete: SetNull)
  media            IncidentMedia[]
  createdAt        DateTime         @default(now())

  @@index([residentId, status])
  @@index([shiftId, status])
  @@index([severity, status, createdAt])
  @@index([createdById])
  @@index([acknowledgedById])
  @@index([resolvedById])
  @@map("incidents")
}

model IncidentMedia {
  id               String   @id @default(uuid()) @db.Uuid
  incidentId       String   @db.Uuid
  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  originalFileName String
  mediaType        String
  byteSize         Int
  storageKey       String
  uploadedById     String?  @db.Uuid
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([uploadedById])
  @@map("incident_media")
}

model AuditEvent {
  id        String         @id @default(uuid()) @db.Uuid
  kind      AuditEventKind
  userId    String?        @db.Uuid
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftId   String?        @db.Uuid
  shift     Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  taskId    String?        @db.Uuid
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime       @default(now())

  @@index([kind, createdAt])
  @@index([userId])
  @@index([shiftId])
  @@index([taskId])
  @@map("audit_events")
}
